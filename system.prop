# Samsung Galaxy Tab S8 Ultra Wi-Fi (SM-X900)
ro.product.board=taro
ro.board.platform=taro
sys.usb.controller=a600000.dwc3
ro.boot.dynamic_partitions=true
ro.crypto.dm_default_key.options_format.version=2
# Save recovery diagnostics to <cache>/fox-debug at boot. Off by default; set 1 here,
# or create <cache>/fox-debug/enable (adb shell touch /cache/fox-debug/enable).
ro.gts8u.debuglog=0
