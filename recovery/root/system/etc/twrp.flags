# TWRP / OrangeFox partition flags for the Galaxy Tab S8 Ultra Wi-Fi (SM-X900)
#<mount_point>      <fs>   <device>                                     <flags>
/system_image       emmc   /dev/block/mapper/system                     flags=backup=1;flashimg=1;display="System Image"
/system_ext_image   emmc   /dev/block/mapper/system_ext                 flags=backup=1;flashimg=1;display="System_ext Image"
/product_image      emmc   /dev/block/mapper/product                    flags=backup=1;flashimg=1;display="Product Image"
/vendor_image       emmc   /dev/block/mapper/vendor                     flags=backup=1;flashimg=1;display="Vendor Image"
/odm_image          emmc   /dev/block/mapper/odm                        flags=backup=1;flashimg=1;display="ODM Image"
/vendor_dlkm_image  emmc   /dev/block/mapper/vendor_dlkm                flags=backup=1;flashimg=1;display="Vendor_dlkm Image"

/boot               emmc   /dev/block/bootdevice/by-name/boot           flags=backup=1;flashimg=1;display="Boot"
/recovery           emmc   /dev/block/bootdevice/by-name/recovery       flags=backup=1;flashimg=1;display="Recovery"
/dtbo               emmc   /dev/block/bootdevice/by-name/dtbo           flags=backup=1;flashimg=1;display="DTBO"
/vendor_boot        emmc   /dev/block/bootdevice/by-name/vendor_boot    flags=backup=1;flashimg=1;display="Vendor Boot"
/vbmeta             emmc   /dev/block/bootdevice/by-name/vbmeta         flags=backup=1;flashimg=1;display="VBMeta"
/vbmeta_system      emmc   /dev/block/bootdevice/by-name/vbmeta_system  flags=backup=1;flashimg=1;display="VBMeta System"
/metadata           ext4   /dev/block/bootdevice/by-name/metadata       flags=backup=1;display="Metadata"
/efs                ext4   /dev/block/bootdevice/by-name/efs            flags=backup=1;display="EFS"
/sec_efs            ext4   /dev/block/bootdevice/by-name/sec_efs        flags=backup=1;display="SEC EFS"
/persist            ext4   /dev/block/bootdevice/by-name/persist        flags=backup=1;display="Persist"
/firmware           vfat   /dev/block/bootdevice/by-name/apnhlos        flags=backup=1;display="Firmware (APNHLOS)";mounttodecrypt
/modem              emmc   /dev/block/bootdevice/by-name/modem          flags=backup=1;display="Modem"
/prism              ext4   /dev/block/bootdevice/by-name/prism          flags=backup=1;display="Prism"
/optics             ext4   /dev/block/bootdevice/by-name/optics         flags=backup=1;display="Optics"
/super              emmc   /dev/block/bootdevice/by-name/super          flags=backup=0;flashimg=1;display="Super (raw)"

/external_sd        auto   /dev/block/mmcblk0p1  /dev/block/mmcblk0     flags=display="MicroSD";storage;wipeingui;removable
/usb-otg            auto   /dev/block/sdg1       /dev/block/sdg         flags=display="USB-OTG";storage;wipeingui;removable
