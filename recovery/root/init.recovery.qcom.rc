#
# Recovery init for the Galaxy Tab S8 Ultra Wi-Fi (SM-X900). Based on the
# stock init.recovery.qcom.rc and init.recovery.samsung.rc. The vendor
# kernel modules are loaded by first-stage init from
# /lib/modules/modules.load.recovery, as in the stock recovery.

on init
    write /sys/class/backlight/panel0-backlight/brightness 200
    setprop sys.usb.controller a600000.dwc3

    # Samsung: /efs is a symlink in the stock skeleton; use real mount points
    rm /efs
    mkdir /efs
    mkdir /sec_efs

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

# Bring-up diagnostics to the cache partition (ro.gts8u.debuglog=1)
service gts8u-debuglog /system/bin/gts8u-debuglog
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

on boot
    start gts8u-debuglog
