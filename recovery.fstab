# Samsung Galaxy Tab S8 Ultra Wi-Fi (SM-X900) recovery fstab
#<src>                                     <mnt_point>    <type> <mnt_flags and options>  <fs_mgr_flags>

# Logical partitions in "super"
system                                     /system        ext4   ro                       wait,logical,first_stage_mount
system                                     /system        erofs  ro                       wait,logical,first_stage_mount
system                                     /system        f2fs   ro                       wait,logical,first_stage_mount
system_ext                                 /system_ext    ext4   ro                       wait,logical,first_stage_mount
system_ext                                 /system_ext    erofs  ro                       wait,logical,first_stage_mount
system_ext                                 /system_ext    f2fs   ro                       wait,logical,first_stage_mount
product                                    /product       ext4   ro                       wait,logical,first_stage_mount
product                                    /product       erofs  ro                       wait,logical,first_stage_mount
product                                    /product       f2fs   ro                       wait,logical,first_stage_mount
vendor                                     /vendor        ext4   ro                       wait,logical,first_stage_mount
vendor                                     /vendor        erofs  ro                       wait,logical,first_stage_mount
vendor                                     /vendor        f2fs   ro                       wait,logical,first_stage_mount
odm                                        /odm           ext4   ro                       wait,logical,first_stage_mount
odm                                        /odm           erofs  ro                       wait,logical,first_stage_mount
odm                                        /odm           f2fs   ro                       wait,logical,first_stage_mount
vendor_dlkm                                /vendor_dlkm   ext4   ro                       wait,logical,first_stage_mount
vendor_dlkm                                /vendor_dlkm   erofs  ro                       wait,logical,first_stage_mount
vendor_dlkm                                /vendor_dlkm   f2fs   ro                       wait,logical,first_stage_mount

/dev/block/bootdevice/by-name/metadata     /metadata      ext4   noatime,nosuid,nodev,discard  wait,check,formattable
/dev/block/bootdevice/by-name/userdata     /data          f2fs   noatime,nosuid,nodev,discard,usrquota,grpquota,fsync_mode=nobarrier,reserve_root=32768,resgid=5678  wait,check,formattable,fileencryption=aes-256-xts:aes-256-cts:v2,metadata_encryption=aes-256-xts:wrappedkey_v0,keydirectory=/metadata/vold/metadata_encryption,quota,fscompress
/dev/block/bootdevice/by-name/cache        /cache         ext4   noatime,nosuid,nodev     wait,check

/dev/block/bootdevice/by-name/boot         /boot          emmc   defaults                 defaults
/dev/block/bootdevice/by-name/recovery     /recovery      emmc   defaults                 defaults
/dev/block/bootdevice/by-name/dtbo         /dtbo          emmc   defaults                 defaults
/dev/block/bootdevice/by-name/vendor_boot  /vendor_boot   emmc   defaults                 defaults
/dev/block/bootdevice/by-name/vbmeta       /vbmeta        emmc   defaults                 defaults
/dev/block/bootdevice/by-name/vbmeta_system /vbmeta_system emmc  defaults                 defaults
/dev/block/bootdevice/by-name/misc         /misc          emmc   defaults                 defaults
/dev/block/bootdevice/by-name/efs          /efs           ext4   defaults                 defaults
/dev/block/bootdevice/by-name/sec_efs      /sec_efs       ext4   defaults                 defaults
/dev/block/bootdevice/by-name/persist      /persist       ext4   defaults                 defaults
/dev/block/bootdevice/by-name/apnhlos      /firmware      vfat   ro                       defaults
/dev/block/bootdevice/by-name/modem        /modem         emmc   defaults                 defaults
/dev/block/bootdevice/by-name/prism        /prism         ext4   defaults                 defaults
/dev/block/bootdevice/by-name/optics       /optics        ext4   defaults                 defaults
/dev/block/bootdevice/by-name/super        /super         emmc   defaults                 defaults

# Removable storage
/dev/block/mmcblk0p1                       /external_sd   auto   defaults                 voldmanaged=sdcard1:auto
/dev/block/sdg1                            /usb-otg       auto   defaults                 voldmanaged=usb:auto
